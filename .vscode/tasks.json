{
  "version": "2.0.0",
  "tasks": [
    {
      // Cmd/Ctrl + Shift + P -> Tasks: Run Task -> Run Spring Boot
      "label": "Run Spring Boot",
      "type": "shell",
      "command": "mvn",
      "args": [
        "spring-boot:run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      // 执行完整 Maven 测试：mvn test
      "label": "Maven Test",
      "type": "shell",
      "command": "mvn",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      // 编译并打包可执行 JAR：mvn package
      "label": "Maven Package",
      "type": "shell",
      "command": "mvn",
      "args": [
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
