# PostgreSQL 容器初始化配置；第一次创建 volume 时使用这些值。
POSTGRES_DB=java_todo_api
POSTGRES_USER=postgres
# 仅为本地学习默认值，真实环境请修改。
POSTGRES_PASSWORD=postgres
# 宿主机访问 PostgreSQL 的端口；容器之间仍使用 postgres:5432。
POSTGRES_PORT=5432

# 宿主机访问 Java 应用的端口，右侧容器端口固定为 8080。
APP_PORT=8080
# Compose 启动应用时默认使用生产 profile，即 PostgreSQL 数据库配置。
SPRING_PROFILES_ACTIVE=prod
# JVM 根据容器可用内存的 75% 计算最大堆内存。
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# 宿主机直接运行应用时使用 localhost；Compose app 服务会覆盖为 postgres 服务名。
DB_URL=jdbc:postgresql://localhost:5432/java_todo_api
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT 签名密钥，生产环境必须替换为长度足够的随机字符串。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JWT Token 有效期，单位为分钟。
JWT_EXPIRATION_MINUTES=120
